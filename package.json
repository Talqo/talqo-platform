{
	"name": "talqo",
	"private": true,
	"license": "SEE LICENSE IN LICENSE.md",
	"packageManager": "bun@1.3.9",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"prepare": "husky",
		"db:start": "docker compose up -d db --wait",
		"db:logs": "docker compose logs --follow db",
		"minio:start": "docker compose up -d minio --wait && docker compose up minio-init",
		"dev": "turbo run dev db:logs",
		"dev:web": "turbo dev --filter=web",
		"dev:api": "turbo dev --filter=api",
		"dev:widget": "cd packages/widget && bun run dev",
		"dev:full": "bun run build:widget && concurrently \"bun run dev:api\" \"bun run dev:web\" \"bun run preview:widget\"",
		"build": "turbo build",
		"build:widget": "cd packages/widget && bun run build",
		"build:widget:production": "cd packages/widget && bun run build:production",
		"preview:widget": "cd packages/widget && bun run preview",
		"lint": "turbo lint",
		"check": "biome check .",
		"type-check": "turbo type-check",
		"i18n-check": "bun run --filter web i18n-check",
		"test": "turbo test --filter=!./apps/e2e",
		"test:integration": "turbo build --filter=db --filter=shared && cd apps/api && bun run test:integration",
		"format": "biome format --write .",
		"fix": "biome check --write --unsafe ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.7",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@typescript/native-preview": "latest",
		"concurrently": "^9.2.1",
		"husky": "^9.1.7",
		"i18next-cli": "^1.65.0",
		"lint-staged": "^15.5.0",
		"turbo": "^2.6.3"
	},
	"lint-staged": {
		"**/*.{ts,tsx,js,jsx,json,css}": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"dependencies": {
		"zod": "^4.4.3"
	}
}
