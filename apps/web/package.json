		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"openapi-typescript": "^7.13.0",
		"shadcn": "^3.8.5",
		"tailwindcss": "^4.2.0",
		"typescript": "^6.0.0",
