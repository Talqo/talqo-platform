{
	"name": "web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsr generate && tsgo --build && vite build",
		"lint": "biome lint .",
		"check": "biome check .",
		"fix": "biome check --write .",
		"type-check": "tsgo --noEmit",
		"test": "bun -e \"console.log('No tests in web')\"",
		"preview": "vite preview",
		"generate-routes": "tsr generate",
		"generate-api": "bun run scripts/generate-api.ts",
		"check-i18n-unused": "bun run scripts/check-i18n-unused.ts",
		"check-i18n-hardcoded": "bash scripts/check-i18n-hardcoded.sh",
		"check-i18n": "bun run check-i18n-unused && bash scripts/check-i18n-hardcoded.sh"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.2.2",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-toast": "^1.2.15",
		"@sentry/react": "^10.52.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tanstack/react-query": "^5.96.1",
		"@tanstack/react-router": "^1.168.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"i18next": "^26.0.7",
		"i18next-http-backend": "^3.0.6",
		"isomorphic-dompurify": "^3.9.0",
		"lucide-react": "^0.575.0",
		"motion": "^12.23.24",
		"openapi-fetch": "^0.17.0",
		"radix-ui": "^1.4.3",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-hook-form": "^7.72.1",
		"react-i18next": "^17.0.4",
		"react-markdown": "^10.1.0",
		"recharts": "^2.15.2",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"shared": "workspace:*",
		"tailwind-merge": "^3.5.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
