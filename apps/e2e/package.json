{
	"name": "e2e",
	"private": true,
	"scripts": {
		"pretest": "PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64 playwright install --with-deps chromium",
		"test": "echo 'E2E tests should be run via: make e2e' && exit 1",
		"test:run": "PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64 playwright install --with-deps chromium && PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64 playwright test",
		"test:ui": "playwright test --ui",
		"test:headed": "playwright test --headed",
		"test:debug": "playwright test --debug"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1"
	}
}
