{
	"name": "api",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "bun --watch --env-file=../../.env run src/index.ts",
		"build": "tsc",
		"lint": "biome lint .",
		"check": "biome check .",
		"fix": "biome check --write .",
		"type-check": "tsc --noEmit",
		"test": "bun test --env-file=../../.env",
		"db:generate": "bun --env-file=../../.env run drizzle-kit generate",
		"db:migrate": "bun --env-file=../../.env run drizzle-kit migrate",
		"db:push": "bun --env-file=../../.env run drizzle-kit push",
		"db:studio": "bun --env-file=../../.env run drizzle-kit studio",
		"db:seed": "bun --env-file=../../.env run src/db/seed.ts"
	},
	"dependencies": {
		"@ai-sdk/mcp": "^1.0.30",
		"@ai-sdk/openai-compatible": "^2.0.37",
		"@hono/zod-openapi": "^1.2.4",
		"@hono/zod-validator": "^0.7.6",
		"@scalar/hono-api-reference": "^0.10.5",
		"ai": "^6.0.141",
		"drizzle-orm": "^0.45.1",
		"hono": "^4.10.8",
		"jose": "^6.2.2",
		"postgres": "^3.4.8",
		"resend": "^6.9.4",
		"shared": "workspace:*",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"drizzle-kit": "^0.31.10",
		"typescript": "~5.9.3"
	}
}
