meta {
  name: Update Custom Server
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/client/me/mcp/custom/{{serverId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{clientToken}}
}

body:json {
  {
    "mcpConfig": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-everything"]
    }
  }
}
