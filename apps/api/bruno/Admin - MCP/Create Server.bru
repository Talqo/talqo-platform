meta {
  name: Create Server
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/admin/mcp/pre-made
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "mcpConfig": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-everything"]
    }
  }
}
