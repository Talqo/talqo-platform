meta {
  name: Update Server
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/admin/mcp/pre-made/{{serverId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "mcpConfig": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-everything"]
    }
  }
}
