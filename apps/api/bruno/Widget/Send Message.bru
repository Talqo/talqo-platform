meta {
  name: Send Message
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/widget/{{clientId}}/sessions/{{sessionId}}/conversations/{{conversationId}}/messages
  body: json
  auth: none
}

headers {
  X-Widget-Token: {{widgetToken}}
}

body:json {
  {
    "content": "Hello, I need help with my order."
  }
}
