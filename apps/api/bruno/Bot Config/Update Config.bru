meta {
  name: Update Config
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/client/me/bot-config
  body: json
  auth: bearer
}

auth:bearer {
  token: {{clientToken}}
}

body:json {
  {
    "systemPrompt": "You are a helpful assistant for our website.",
    "defaultRole": "Customer Support Agent",
    "toneStyle": "professional",
    "internetSearchEnabled": false
  }
}
