# Database — used by docker-compose (db service) and API
POSTGRES_USER=pagepal
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
# make e2e overrides this with a free ephemeral port so parallel worktrees never clash
POSTGRES_PORT=5432
POSTGRES_DB=pagepal

# API server
API_PORT=3000
JWT_SECRET=dev-secret-key-minimum-32-characters
JWT_EXPIRES_IN=24h

# Email (Resend) — leave blank if not testing email flows locally
RESEND_API_KEY=re_example_key
APP_URL=http://localhost:5173

# S3 / MinIO file storage — MinIO runs via Helm/docker locally
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pagepal-files

# Provider key — 64 hex characters (32-byte AES-256-GCM key) — generate with: openssl rand -hex 32
PROVIDER_KEY_SECRET=0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20

# Widget rate limiting — max messages per IP per hour
WIDGET_RATE_LIMIT_PER_HOUR=60
# Max messages per conversation before user must start a new one
WIDGET_CONVERSATION_MAX_MESSAGES=50

# Comma-separated trusted proxy IPs (e.g., nginx ingress).
# When the direct connection is from one of these IPs, X-Forwarded-For is read
# to extract the real client IP for rate limiting. Private/internal IPs
# (10.x, 172.16-31.x, 192.168.x, 127.x) are auto-trusted.
# TRUSTED_PROXY_IPS=

# Default LLM provider — all clients use this unless they configure their own
# Uncomment and set all three (type, apiKey, model) to enable the default provider.
# When type is openai_compatible, DEFAULT_LLM_BASE_URL is also required.
# DEFAULT_LLM_PROVIDER_TYPE=openai
# DEFAULT_LLM_API_KEY=sk-your-key-here
# DEFAULT_LLM_MODEL=gpt-4o-mini
# DEFAULT_LLM_BASE_URL=

# Web dev server (Vite) — only used by `bun run dev`, NOT by Docker builds
VITE_API_URL=http://localhost:3000

# Playwright E2E base URL
BASE_URL=http://localhost:5173
