{
	"name": "widget",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "dist/widget-bundle.js",
	"scripts": {
		"dev": "concurrently \"bun run dev:spa\" \"bun run dev:bundle\"",
		"dev:spa": "vite --mode development",
		"dev:bundle": "concurrently \"tsgo --watch\" \"vite build --watch --emptyOutDir=false\" \"vite preview --strictPort\"",
		"build": "tsgo && vite build --mode production",
		"build:e2e": "tsgo && vite build --mode production && cp demo.html dist/index.html",
		"build:watch": "vite build --watch --mode production",
		"preview": "vite preview --strictPort",
		"lint": "biome lint .",
		"check": "biome check .",
		"fix": "biome check --write .",
		"type-check": "tsgo --noEmit",
		"test": "bun -e \"console.log('No tests in widget')\""
	},
	"dependencies": {
		"isomorphic-dompurify": "^2.24.0",
		"react": "^19",
		"react-dom": "^19",
		"react-markdown": "^10.1.0",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1"
	},
	"devDependencies": {
		"@types/react": "^19.2.7",
		"shared": "workspace:*",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"concurrently": "^9.2.1",
		"esbuild": "^0.23.0",
		"typescript": "^6.0.0",
		"vite": "^8.0.8",
		"vite-plugin-css-injected-by-js": "^3.5.2",
		"vite-plugin-svgr": "^4.5.0"
	}
}
