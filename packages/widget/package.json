{
	"name": "widget",
	"version": "0.0.0",
	"private": false,
	"type": "module",
	"main": "dist/widget-bundle.js",
	"scripts": {
		"dev": "vite",
		"dev:spa": "vite --mode development",
		"dev:bundle": "concurrently \"tsc --watch\" \"vite build --watch --emptyOutDir=false\" \"vite preview --port 5174 --strictPort\"",
		"build": "tsc && vite build --mode production",
		"build:watch": "vite build --watch --mode production",
		"preview": "vite preview --port 5174 --strictPort",
		"lint": "biome lint .",
		"check": "biome check .",
		"fix": "biome check --write .",
		"type-check": "tsc --noEmit",
		"test": "bun -e \"console.log('No tests in widget')\""
	},
	"dependencies": {
		"isomorphic-dompurify": "^2.24.0",
		"react": "^19",
		"react-dom": "^19"
	},
	"devDependencies": {
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"typescript": "^6.0.0",
		"vite": "^8.0.8",
		"vite-plugin-css-injected-by-js": "^3.5.2",
		"vite-plugin-svgr": "^4.5.0"
	}
}
